{
  "name": "@zxabinbina/myriad-ui",
  "version": "0.1.0",
  "description": "万象（Myriad）的 Vue 3 界面：网格、文件夹、Dock、搜索、时钟与设置。",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "typecheck": "vue-tsc -p tsconfig.json",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@lucide/vue": "^1.70.0",
    "@zxabinbina/myriad-core": "0.1.0",
    "dompurify": "^3.4.17",
    "interestfor": "^1.0.14",
    "lucide": "^1.70.0",
    "marked": "^18.2.0",
    "simple-icons": "^16.36.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zxaBinbina/myriad.git",
    "directory": "packages/ui"
  },
  "devDependencies": {
    "vite": "^8.3.6",
    "vue": "^3.5.45",
    "@vitejs/plugin-vue": "^6.0.10"
  },
  "peerDependencies": {
    "vue": "^3.5.22"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
